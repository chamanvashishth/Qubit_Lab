# Supabase browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Vercel AI Gateway configuration for the server-side /api/chat function
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-2.5-flash

# Server-side Gemini key for /api/chat (never expose as a VITE_ variable)
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
